# Mode
PAPER_MODE=true

# Strategy / risk
MAX_SPEND_PER_TRADE=1.0
MIN_EDGE_TO_TRADE=0.08
COOLDOWN_SECONDS=60
LOOP_SLEEP_SECONDS=2
MIN_SECONDS_TO_EXPIRY=40
MAX_SECONDS_TO_EXPIRY=900
MAX_PRICE_AGE_SECONDS=5

# Kalshi credentials
KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Optional: force a ticker (recommended at first)
# KALSHI_MARKET_TICKER=KXBTCD-24APR151230-T65000

# Optional Webull-compatible JSON price endpoint (leave blank to disable)
WEBULL_PRICE_URL=

# Files
HISTORICAL_CSV=data/historical_samples.csv
MODEL_PATH=models/logistic_model.joblib
DECISION_LOG_CSV=logs/decisions.csv
